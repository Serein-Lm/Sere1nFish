{
	admin 127.0.0.1:2019
	auto_https disable_redirects
}

{$DEEPFAKE_PUBLIC_HOST} {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	@internal path /internal/*
	respond @internal 404

	@media_output path /api/v1/media-output/view /api/v1/media-output/watch
	handle @media_output {
		reverse_proxy https://127.0.0.1:18443 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	@media path /media/*
	handle @media {
		reverse_proxy 127.0.0.1:8889
	}

	handle {
		reverse_proxy 127.0.0.1:8443
	}
}

https://{$DEEPFAKE_LEGACY_HOST} {
	tls /etc/caddy/legacy/tls.crt /etc/caddy/legacy/tls.key

	@internal path /internal/*
	respond @internal 404

	@media path /media/*
	handle @media {
		reverse_proxy 127.0.0.1:8889
	}

	handle {
		reverse_proxy 127.0.0.1:8443
	}
}

https://{$DEEPFAKE_TUNNEL_HOST} {
	tls /etc/caddy/legacy/tls.crt /etc/caddy/legacy/tls.key

	@internal path /internal/*
	respond @internal 404

	@media path /media/*
	handle @media {
		reverse_proxy 127.0.0.1:8889
	}

	handle {
		reverse_proxy 127.0.0.1:8443
	}
}
