# Public identity of the GPU node. For an IPv4 node, sslip.io can be used,
# for example 203-0-113-10.sslip.io.
DEEPFAKE_PUBLIC_HOST=203-0-113-10.sslip.io
DEEPFAKE_LEGACY_HOST=203.0.113.10
DEEPFAKE_WEBRTC_ADDITIONAL_HOSTS=203.0.113.10
DEEPFAKE_TUNNEL_HOST=172.18.0.1

# Persistent host paths. Secrets are generated by deploy/deploy-from-main.sh.
DEEPFAKE_ROOT=/opt/sere1nfish/deepfake
DEEPFAKE_ASSETS_DIR=/opt/sere1nfish/deepfake/data/assets
DEEPFAKE_CACHE_DIR=/opt/sere1nfish/deepfake/data/cache
MEANVC_MODELS_DIR=/opt/sere1nfish/deepfake/data/meanvc
DEEPFAKE_CADDY_DATA_DIR=/opt/sere1nfish/deepfake/data/caddy
DEEPFAKE_CADDY_CONFIG_DIR=/opt/sere1nfish/deepfake/data/caddy-config
DEEPFAKE_TOKEN_FILE=/opt/sere1nfish/deepfake/secrets/api-token
MEANVC_TOKEN_FILE=/opt/sere1nfish/deepfake/secrets/meanvc-token
DEEPFAKE_TLS_CERT_FILE=/opt/sere1nfish/deepfake/secrets/tls.crt
DEEPFAKE_TLS_KEY_FILE=/opt/sere1nfish/deepfake/secrets/tls.key
DEEPFAKE_FACEFUSION_CONFIG_FILE=/opt/sere1nfish/deepfake/current/deepfake_gateway/facefusion.ini

# Pinned runtime images and source identities.
FACEFUSION_COMMIT=3f81a8a78454089d720b8f318a12ae1702c4633b
FACEFUSION_BASE_IMAGE=sere1nfish/facefusion:3.7.1-cuda12.8-py312
DEEPFAKE_GATEWAY_IMAGE=sere1nfish/deepfake-gateway:1.5.1
MEANVC_IMAGE=sere1nfish/meanvc-runtime:1.0.0
MEDIAMTX_IMAGE=bluenviron/mediamtx:1.19.3
CADDY_IMAGE=caddy:2.10.2-alpine

# Leave empty when the GPU node has direct Internet access. When the main
# server creates the optional reverse proxy tunnel, use loopback port 17890.
HTTP_PROXY=
HTTPS_PROXY=
PIP_INDEX_URL=https://pypi.org/simple
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu124

DEEPFAKE_MAX_SESSIONS=2
DEEPFAKE_SESSION_TTL_SECONDS=900
DEEPFAKE_DEFAULT_IMAGE_PROFILE=quality
DEEPFAKE_DEFAULT_REALTIME_PROFILE=fast
DEEPFAKE_MEDIA_OUTPUT_FPS=15
